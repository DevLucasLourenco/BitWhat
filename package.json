{
  "name": "bitwhat",
  "version": "0.1.0",
  "description": "Cliente desktop local para WhatsApp Web com tray, Electron, React, TypeScript e Vite.",
  "productName": "BitWhat",
  "main": "./out/main/index.js",
  "author": "BitWhat",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "npm run icons && electron-vite dev",
    "build": "npm run icons && npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win nsis",
    "preview": "npm run build && electron-vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "postinstall": "npm run icons"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.3"
  }
}
